  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", () => {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "// Trích xuất id động để các request sau dùng\r",
                  "const json = pm.response.json();\r",
                  "pm.test(\"Response có id\", () => pm.expect(json.id).to.be.a(\"number\"));\r",
                  "pm.environment.set(\"userId\", json.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Đọc dòng CSV hiện tại; có giá trị mặc định khi chạy tay không có CSV\r",
                  "const d = pm.iterationData;\r",
                  "const email = d.get(\"email\") || \"demo@example.com\";\r",
                  "const [local, domain] = email.split(\"@\");\r",
                  "\r",
                  "pm.variables.set(\"u_name\", d.get(\"name\") || \"Demo User\");\r",
                  "pm.variables.set(\"u_gender\", d.get(\"gender\") || \"male\");\r",
                  "pm.variables.set(\"u_status\", d.get(\"status\") || \"active\");\r",
                  "\r",
                  "// Thêm timestamp để email không bao giờ trùng giữa các lần chạy\r",
                  "const unique = `${local}.${Date.now()}@${domain}`;\r",
                  "pm.variables.set(\"u_email\", unique);\r",
                  "pm.environment.set(\"lastEmail\", unique); // lưu cho request 6"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{u_name}}\",\r\n  \"gender\": \"{{u_gender}}\",\r\n  \"email\": \"{{u_email}}\",\r\n  \"status\": \"{{u_status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/users",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\r",
                  "\r",
                  "pm.test(\"Đúng user vừa tạo\", () => {\r",
                  "    const j = pm.response.json();\r",
                  "    pm.expect(j.id).to.eql(Number(pm.environment.get(\"userId\")));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disabledSystemHeaders": {}
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/users/{{userId}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\r",
                  "pm.test(\"Status đã đổi thành inactive\", () => {\r",
                  "    pm.expect(pm.response.json().status).to.eql(\"inactive\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"inactive\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/users/{{userId}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Inative User",
          "event": [
            {
              "listen": "test",
              "script": {
